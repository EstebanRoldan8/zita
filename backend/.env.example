PORT=
NODE_ENV=
FRONTEND_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=
WHATSAPP_PHONE_NUMBER_ID=
ENCRYPT_SECRET=
SUPERADMIN_EMAIL=
SENTRY_DSN=https://your-sentry-key@sentry.io/project-id

# TRIAL
TRIAL_DAYS=30

# PAGOS - COLOMBIA (Wompi)
WOMPI_PUBLIC_KEY_CO=pub_test_...
WOMPI_PRIVATE_KEY_CO=prv_test_...
WOMPI_EVENTS_SECRET_CO=test_events_...
WOMPI_INTEGRITY_SECRET_CO=test_integrity_...
WOMPI_API_URL=https://sandbox.wompi.co/v1

# PAGOS - MÉXICO (MercadoPago - futuro)
# MERCADOPAGO_PUBLIC_KEY_MX=
# MERCADOPAGO_PRIVATE_KEY_MX=

# WHATSAPP - ventana de 24 h y plantillas (ver docs/PLANTILLAS_WHATSAPP.md)
# Activar SOLO cuando las plantillas estén aprobadas en Meta para cada número. Sin esto, los avisos fuera de
# la ventana de 24 h salen como texto libre (como antes) y Meta probablemente los descarte (error 131047).
WA_TEMPLATES_ENABLED=false
# El idioma de cada plantilla está en TEMPLATE_CONFIG (whatsappNotify.js); WA_TEMPLATE_LANG solo aplica a plantillas fuera del mapa
# WA_TEMPLATE_LANG=es
# Nombres de plantilla. Obligatorios con plantillas activas: WA_TPL_FIN_PRUEBA y WA_TPL_PAGO_RECHAZADO (en Meta quedaron como *_v2)
WA_TPL_FIN_PRUEBA=aviso_fin_prueba_v2
WA_TPL_PAGO_RECHAZADO=pago_rechazado_v2
# Opcionales (por defecto los de la guía)
# WA_TPL_RECORDATORIO=recordatorio_cita
# WA_TPL_NUEVA_CITA=aviso_nueva_cita
# WA_TPL_ESCALAMIENTO=aviso_escalamiento
# WA_TPL_RESUMEN=resumen_diario
# WA_TPL_PLAN_VENCIDO=plan_vencido
# WA_TPL_TE_EXTRANAMOS=te_extranamos
# WA_TPL_CITA_CANCELADA=aviso_cita_cancelada
# Número global de ZITA (opcional) para los avisos de ZITA a sus clientes: aviso_fin_prueba y pago_rechazado.
# Deben estar LAS DOS; si falta alguna se usa el número por defecto (WHATSAPP_PHONE_NUMBER_ID / WHATSAPP_ACCESS_TOKEN).
# Las plantillas de esos dos avisos tienen que estar aprobadas en la WABA de este número.
# WA_PLATFORM_PHONE_NUMBER_ID=
# WA_PLATFORM_ACCESS_TOKEN=
# Mensajes más viejos que esto (minutos) no se responden (reintentos de Meta tras una caída)
BOT_MAX_MESSAGE_AGE_MIN=30

# RATE LIMIT - IP del cliente en rutas públicas sensibles (invitaciones de empleados)
# Vacío: usa req.ip (app.set('trust proxy', 1)). En Railway el edge reescribe X-Real-IP en cada petición;
# poner x-real-ip SOLO si el backend corre detrás de ese edge (si no, el cliente podría falsificarlo).
# RATE_LIMIT_IP_HEADER=x-real-ip
