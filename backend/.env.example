PORT=
NODE_ENV=
FRONTEND_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=
WHATSAPP_PHONE_NUMBER_ID=
ENCRYPT_SECRET=
SUPERADMIN_EMAIL=
SENTRY_DSN=https://your-sentry-key@sentry.io/project-id

# TRIAL
TRIAL_DAYS=30

# PAGOS - COLOMBIA (Wompi)
WOMPI_PUBLIC_KEY_CO=pub_test_...
WOMPI_PRIVATE_KEY_CO=prv_test_...
WOMPI_EVENTS_SECRET_CO=test_events_...
WOMPI_INTEGRITY_SECRET_CO=test_integrity_...
WOMPI_API_URL=https://sandbox.wompi.co/v1

# PAGOS - MÉXICO (MercadoPago - futuro)
# MERCADOPAGO_PUBLIC_KEY_MX=
# MERCADOPAGO_PRIVATE_KEY_MX=

# WHATSAPP - ventana de 24 h y plantillas (ver docs/PLANTILLAS_WHATSAPP.md)
# Activar SOLO cuando las plantillas estén aprobadas en Meta para cada número. Sin esto, los avisos fuera de
# la ventana de 24 h salen como texto libre (como antes) y Meta probablemente los descarte (error 131047).
WA_TEMPLATES_ENABLED=false
WA_TEMPLATE_LANG=es
# Nombres de plantilla (opcionales; por defecto los de la guía)
# WA_TPL_RECORDATORIO=recordatorio_cita
# WA_TPL_NUEVA_CITA=aviso_nueva_cita
# WA_TPL_ESCALAMIENTO=aviso_escalamiento
# WA_TPL_RESUMEN=resumen_diario
# WA_TPL_PLAN_VENCIDO=plan_vencido
# WA_TPL_FIN_PRUEBA=aviso_fin_prueba
# WA_TPL_PAGO_RECHAZADO=pago_rechazado
# WA_TPL_TE_EXTRANAMOS=te_extranamos
# Mensajes más viejos que esto (minutos) no se responden (reintentos de Meta tras una caída)
BOT_MAX_MESSAGE_AGE_MIN=30
