# Supabase configuration for authentication and database
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Backend API endpoint - use http://localhost:3000 for local development
VITE_API_URL=https://zita-production.up.railway.app

# Admin email for superadmin role detection
VITE_SUPERADMIN_EMAIL=esteban.zita.ia@gmail.com

# Sentry error monitoring
VITE_SENTRY_DSN=https://b7b219d4c434642f5bf801ec95dfb571@o4511504203776000.ingest.us.sentry.io/4511504297033728

# ── Tienda pública: SEO (funciones de Vercel en api/, SOLO servidor, sin prefijo VITE_) ──
# URL de la API pública (backend) que leen sitemap, robots y prerender. Sin barra final.
STORE_API_URL=https://zita-production.up.railway.app
# Dominio canónico de la tienda, sin barra final (el sitemap y los canonical usan este dominio)
SITE_URL=https://tu-dominio.com
# Slug de la tienda que va en el sitemap (y la que se sirve en la raíz con dominio propio)
STORE_SLUG=flow

# Dominio propio de la tienda (opcional). Si se definen, ese dominio sirve la tienda en la raíz y es el
# dominio CANÓNICO de la tienda (también para /tienda/<slug> en el dominio de ZITA). VITE_STORE_HOST es solo
# el host, sin https:// ni barra (en producción: www.flowactivewear.co). SITE_URL debe ser https://ese-host.
# Las funciones de SEO leen los mismos valores para saber en qué modo está cada host.
# VITE_STORE_HOST=www.flowactivewear.co
# VITE_STORE_HOST_SLUG=flow
